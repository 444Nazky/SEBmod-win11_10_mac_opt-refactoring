u0642\u0627\u0628\u0644\u06cc\u062a\u200c\u0647\u0627\u06cc \u0633\u0645\u062a \u0633\u0631\u0648 \u063a\u06cc\u0631\u0641\u0639\u0627\u0644 \u062e\u0648\u0627\u0647\u0646\u062f \u0634\u062f\u060c \u0642\u0627\u0628\u0644\u06cc\u062a\u200c\u0647\u0627\u06cc\u06cc \u0627\u0632 \u0642\u0628\u06cc\u0644:\u0636\u0628\u0637\u060c \u067e\u062e\u0634 \u0632\u0646\u062f\u0647 \u0648 \u0645\u0634\u0627\u0631\u06a9\u062a \u062a\u0644\u0641\u0646\u06cc \u062f\u0631 \u062c\u0644\u0633\u0627\u062a\u061b \u0647\u0645\u0686\u0646\u06cc\u0646  \u0627\u0641\u0631\u0627\u062f\u06cc \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u0646\u062f \u0628\u0647 \u0627\u06cc\u0646 \u062c\u0644\u0633\u0647 \u0628\u067e\u06cc\u0648\u0646\u062f\u0646\u062f \u06a9\u0647 \u0645\u0631\u0648\u0631\u06af\u0631 \u0622\u0646\u200c\u0647\u0627 \u0627\u0632 \u0642\u0627\u0628\u0644\u06cc\u062a \u067e\u062e\u0634 \u062f\u0631\u0648\u0646 \u0645\u0631\u0648\u0631\u06af\u0631\u06cc \u067e\u0634\u062a\u06cc\u0628\u0627\u0646\u06cc \u06a9\u0646\u062f\u060c</p>",e2eeLabel:"\u06a9\u0644\u06cc\u062f E2EE",e2eeWarning:"<br /><p><strong>\u0647\u0634\u062f\u0627\u0631:</strong> \u0647\u0645\u0647\u200c\u06cc \u0645\u0634\u0627\u0631\u06a9\u062a \u06a9\u0646\u0646\u062f\u06af\u0627\u0646 \u0631\u0645\u0632\u0646\u06af\u0627\u0631\u06cc \u062f\u0648 \u0637\u0631\u0641\u0647 \u0631\u0627 \u067e\u0634\u062a\u06cc\u0628\u0627\u0646\u06cc \u0646\u0645\u06cc\u200c\u06a9\u0646\u0646\u062f\u061b \u0627\u06af\u0631 \u0627\u06cc\u0646 \u0642\u0627\u0628\u0644\u06cc\u062a \u0631\u0627 \u0641\u0639\u0627\u0644 \u06a9\u0646\u06cc\u062f \u0622\u0646\u200c\u0647\u0627 \u0635\u062f\u0627\u06cc \u062c\u0644\u0633\u0647 \u0631\u0627 \u0646\u0645\u06cc\u200c\u0634\u0646\u0648\u0646\u062f \u0648 \u062a\u0635\u0648\u06cc\u0631 \u0631\u0627 \u0645\u0634\u0627\u0647\u062f\u0647 \u0646\u062e\u0648\u0627\u0647\u0646\u062f \u06a9\u0631\u062f</p>",enterDisplayName:"\u0644\u0637\u0641\u0627 \u0646\u0627\u0645 \u0646\u0645\u0627\u06cc\u0634\u06cc \u